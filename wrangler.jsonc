{
  // Must exactly match the Worker's name in the Cloudflare dashboard, or
  // deploying will create a second Worker instead of updating this one.
  "name": "scorechalk",
  "compatibility_date": "2026-09-28",

  // The live site, plus the www host that redirects to it. Declaring these
  // here rather than clicking them into the dashboard means a fresh clone can
  // rebuild the whole deployment from this file. Cloudflare creates and
  // manages the DNS record for each custom domain, so there is nothing to add
  // by hand in the zone.
  "routes": [
    { "pattern": "scorechalk.com", "custom_domain": true },
    { "pattern": "www.scorechalk.com", "custom_domain": true }
  ],

  // The games are static; the Worker handles the www redirect and the /auth
  // and /api routes behind sign-in.
  "main": "worker/index.js",

  // Accounts and game history. GOOGLE_CLIENT_SECRET and SESSION_SECRET are
  // secrets (wrangler secret put), not vars — they must never live in here.
  // GOOGLE_CLIENT_ID is public by design: it travels in the sign-in URL.
  "vars": {
    // Pinned so the OAuth redirect_uri always matches what is registered with
    // Google, whatever host the request arrived on.
    "PUBLIC_ORIGIN": "https://scorechalk.com",

    // Public by design — it travels in the sign-in URL. The matching secret is
    // set with `wrangler secret put` and must never appear in this file.
    "GOOGLE_CLIENT_ID": "35240829771-8e7dastnmvt8ktfkfg7k225su1k6mr58.apps.googleusercontent.com"
  },

  // Shared games are open to anyone holding a link, signed in or not, so
  // their API is limited per visitor (by IP address) — see worker/index.js.
  // A period is 10 or 60 seconds. Several phones on one Wi-Fi share an IP,
  // which is why reads are generous: during Cribbage's play each phone
  // looks for news every second.
  "ratelimits": [
    { "name": "SHARE_CREATE", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SHARE_WRITE", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } },
    { "name": "SHARE_READ", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    // error reports from the pages (/api/errors)
    { "name": "ERRORS", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],

  // Workers Logs, in the dashboard under the Worker's Logs tab: a tenth of
  // requests, which keeps well inside the free allowance while the pages
  // look for news every few seconds. Errors don't rely on it — they are
  // kept in the errors table (see worker/errors.js).
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },

  // Once a day: shared games that have gone 30 days without a change are
  // deleted (worker/share.js, cleanShares), as the privacy policy says, and
  // errors unseen for 30 days (worker/errors.js).
  "triggers": { "crons": ["17 4 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scorechalk",
      "database_id": "618664cf-96de-4278-ae3a-7112d0ddfa1f"
    }
  ],

  "assets": {
    // Everything in here is published, and nothing else is. Pointing this at
    // the repo root instead would upload .git and README.md, and would make
    // `wrangler dev` watch its own .wrangler scratch directory — which sends
    // it into a reload loop.
    "directory": "public",

    // The app has no client-side routing, so there is no route for a fallback
    // to rescue. A wrong path is genuinely not found, and says so.
    "not_found_handling": "none",

    "binding": "ASSETS",

    // Without this the asset store answers first and the Worker never sees a
    // request for a path that exists — so www./ would serve the site instead
    // of redirecting. The redirect has to be decided before assets are tried.
    "run_worker_first": true
  }
}
