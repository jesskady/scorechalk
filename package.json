{
  "name": "scorechalk",
  "private": true,
  "description": "Score Chalk: scorekeeping for the games you play. See README.md.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "deploy": "node scripts/sitemap.mjs && wrangler deploy && node scripts/indexnow.mjs",
    "test": "node --test --test-timeout=600000 tests/all.test.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "previews": "node scripts/previews.mjs",
    "store-shots": "node scripts/store-shots.mjs",
    "work": "node scripts/work.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0",
    "wrangler": "^4.147.0"
  }
}
